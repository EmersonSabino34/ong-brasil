# Modelo das variáveis de ambiente.
# No computador: copie para ".env.local" e preencha. Na Vercel: Settings → Environment Variables.
# NUNCA coloque os valores reais neste arquivo (ele vai para o GitHub).

# --- Obrigatórias na Vercel ---------------------------------------------------

# Banco Postgres (Neon). Na Vercel é criada sozinha em Storage → Neon → Connect.
# Sem ela, o site guarda tudo na pasta .data (só serve no computador).
DATABASE_URL=

# Chave secreta das sessões (40+ caracteres aleatórios). Gere com:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET=

# Login do painel administrativo (/admin)
ADMIN_EMAIL=
ADMIN_PASSWORD=

# --- Opcionais ----------------------------------------------------------------

# E-mails (recuperação de senha + avisos de novos formulários) pela Resend: https://resend.com
RESEND_API_KEY=
EMAIL_FROM="Infinita Esperança <contato@seudominio.org>"
# Quem recebe os avisos de novos formulários (padrão: ADMIN_EMAIL)
NOTIFY_EMAIL=

# Endereço oficial do site, quando tiver domínio próprio (padrão: o domínio da Vercel)
SITE_URL=
